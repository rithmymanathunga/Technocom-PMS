<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Account page: 3 cards, each opens a pop-up -->
<VBox spacing="16" styleClass="page-root" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lk.technocom.pages.AccountPage">
    <padding><Insets top="20" right="26" bottom="26" left="26"/></padding>
    <VBox spacing="2">
        <Label text="Account" styleClass="h1"/>
        <Label text="My Profile, Change Password and Notifications - each opens as a pop-up" styleClass="sub"/>
    </VBox>
    <HBox spacing="14">
        <VBox styleClass="card" spacing="8" prefWidth="300">
            <Label text="My Profile" styleClass="section-title"/>
            <Label text="Name, contact details, role" styleClass="sub"/>
            <Button text="Open Profile" styleClass="btn-primary" onAction="#onProfile"/>
        </VBox>
        <VBox styleClass="card" spacing="8" prefWidth="300">
            <Label text="Change Password" styleClass="section-title"/>
            <Label text="Update your password securely" styleClass="sub"/>
            <Button text="Change Password" styleClass="btn-primary" onAction="#onPassword"/>
        </VBox>
        <VBox styleClass="card" spacing="8" prefWidth="300">
            <Label text="Notifications" styleClass="section-title"/>
            <Label fx:id="lblUnread" text="0 unread alerts" styleClass="sub"/>
            <Button text="View Notifications" styleClass="btn-primary" onAction="#onNotifications"/>
        </VBox>
    </HBox>
</VBox>
