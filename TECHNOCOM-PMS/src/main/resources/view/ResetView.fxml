<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<!-- Forgot password: 4 steps (email / code / new password / done). Each step is one VBox (stepEmail ... stepDone).
     In Scene Builder: select a step in the Document > Hierarchy panel and tick "Visible" to design it. -->
<StackPane fx:id="root" styleClass="login-root" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="lk.technocom.controller.ResetController">
    <Group>
        <Pane fx:id="canvas" prefWidth="1440" prefHeight="1024" minWidth="1440" minHeight="1024"
              maxWidth="1440" maxHeight="1024" styleClass="login-canvas">

            <!-- Left photo (clipped in the controller) -->
            <Pane fx:id="photoPane" prefWidth="760" prefHeight="1024" layoutX="0" layoutY="0">
                <ImageView fitWidth="760" fitHeight="1024" preserveRatio="false">
                    <image><Image url="@../images/login_building.jpg"/></image>
                </ImageView>
                <Rectangle width="760" height="1024" styleClass="login-top-shade" mouseTransparent="true"/>
            </Pane>

            <!-- Gold lines -->
            <Line startX="752" startY="0" endX="585" endY="422" styleClass="login-gold-thick"/>
            <Line startX="585" startY="422" endX="732" endY="645" styleClass="login-gold-thin"/>
            <Line startX="60" startY="0" endX="60" endY="238" styleClass="login-gold-faint"/>
            <Line startX="0" startY="126" endX="252" endY="0" styleClass="login-gold-faint"/>
            <Line startX="0" startY="267" endX="60" endY="238" styleClass="login-gold-faint"/>
            <Line startX="1319" startY="1024" endX="1440" endY="902" styleClass="login-gold-thick"/>

            <!-- Left: logo and tagline -->
            <ImageView fitWidth="335" preserveRatio="true" layoutX="105" layoutY="92">
                <image><Image url="@../images/logo.png"/></image>
            </ImageView>
            <Line startX="114" startY="312" endX="170" endY="312" styleClass="login-gold-thin"/>
            <VBox layoutX="114" layoutY="335" spacing="2">
                <Label fx:id="lblTag1" text="Building Smarter," styleClass="login-tagline"/>
                <Label fx:id="lblTag2" text="Engineering a Better Tomorrow." styleClass="login-tagline"/>
            </VBox>

            <ComboBox fx:id="cbLanguage" layoutX="1194" layoutY="60" prefWidth="159" prefHeight="43" styleClass="login-lang"/>

            <!-- Right: the card, centred vertically -->
            <StackPane layoutX="770" layoutY="0" prefWidth="610" prefHeight="1024">
                <VBox fx:id="card" styleClass="reset-card" spacing="14" prefWidth="540" maxWidth="540" maxHeight="-Infinity">

                    <!-- progress: 3 gold segments -->
                    <HBox fx:id="progress" spacing="8">
                        <Region fx:id="seg1" HBox.hgrow="ALWAYS" styleClass="seg,seg-on"/>
                        <Region fx:id="seg2" HBox.hgrow="ALWAYS" styleClass="seg,seg-off"/>
                        <Region fx:id="seg3" HBox.hgrow="ALWAYS" styleClass="seg,seg-off"/>
                    </HBox>

                    <HBox alignment="CENTER">
                        <ImageView fitWidth="230" preserveRatio="true">
                            <image><Image url="@../images/logo.png"/></image>
                        </ImageView>
                    </HBox>

                    <!-- ================= STEP 1: username / email ================= -->
                    <VBox fx:id="stepEmail" spacing="12">
                        <TextFlow>
                            <Text fx:id="txtT1" text="Reset your " styleClass="reset-title-white"/>
                            <Text fx:id="txtT2" text="password" styleClass="reset-title-gold"/>
                        </TextFlow>
                        <Label fx:id="lblEmailSub" text="Enter your username or email" styleClass="reset-sub"/>
                        <Label fx:id="lblIdentityLabel" text="Username or Email" styleClass="reset-label"/>
                        <StackPane alignment="CENTER_LEFT">
                            <TextField fx:id="tfIdentity" prefHeight="56" styleClass="reset-field"/>
                            <SVGPath translateX="18" mouseTransparent="true" styleClass="login-icon"
                                     content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z" scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                        <Label fx:id="lblNotice" text="If the account exists, a code has been sent. Code is valid for 10 minutes."
                               wrapText="true" styleClass="reset-notice"/>
                        <Label fx:id="lblEmailError" wrapText="true" styleClass="login-error"/>
                        <Button fx:id="btnSend" text="Send Reset Code  →" maxWidth="Infinity" prefHeight="56"
                                styleClass="login-btn" onAction="#onSendCode"/>
                        <HBox alignment="CENTER">
                            <Button fx:id="btnContact" text="Contact Administrator" styleClass="login-link-small" onAction="#onContact"/>
                        </HBox>
                        <HBox alignment="CENTER">
                            <Button fx:id="btnBack1" text="←  Back to Login" styleClass="login-link" onAction="#onBack"/>
                        </HBox>
                    </VBox>

                    <!-- ================= STEP 2: 6 digit code ================= -->
                    <VBox fx:id="stepCode" spacing="12" visible="false" managed="false">
                        <Label fx:id="lblVerifyTitle" text="Verify reset code" styleClass="reset-title-white"/>
                        <Label fx:id="lblVerifySub" text="Enter the 6-digit code sent to your email:" wrapText="true" styleClass="reset-sub"/>
                        <Label fx:id="lblMasked" text="b•••••@technocom.lk" styleClass="reset-masked"/>
                        <HBox fx:id="codeRow" spacing="12" alignment="CENTER">
                        <TextField fx:id="c1" prefWidth="64" prefHeight="68" styleClass="code-box"/>
                        <TextField fx:id="c2" prefWidth="64" prefHeight="68" styleClass="code-box"/>
                        <TextField fx:id="c3" prefWidth="64" prefHeight="68" styleClass="code-box"/>
                        <TextField fx:id="c4" prefWidth="64" prefHeight="68" styleClass="code-box"/>
                        <TextField fx:id="c5" prefWidth="64" prefHeight="68" styleClass="code-box"/>
                        <TextField fx:id="c6" prefWidth="64" prefHeight="68" styleClass="code-box"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="lblExpires" text="Code expires in 10:00" styleClass="reset-small"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnResend" text="Resend code" styleClass="reset-resend" onAction="#onResend"/>
                        </HBox>
                        <Label fx:id="lblCodeError" wrapText="true" styleClass="login-error"/>
                        <Button fx:id="btnVerify" text="Verify Code  →" maxWidth="Infinity" prefHeight="56"
                                styleClass="login-btn" onAction="#onVerify"/>
                        <HBox alignment="CENTER">
                            <Button fx:id="btnBack2" text="←  Back to Login" styleClass="login-link" onAction="#onBack"/>
                        </HBox>
                    </VBox>

                    <!-- ================= STEP 3: new password ================= -->
                    <VBox fx:id="stepPassword" spacing="10" visible="false" managed="false">
                        <TextFlow>
                            <Text fx:id="txtP1" text="Create new " styleClass="reset-title-white"/>
                            <Text fx:id="txtP2" text="password" styleClass="reset-title-gold"/>
                        </TextFlow>
                        <Label fx:id="lblPwSub" text="Use at least 8 characters with a number" styleClass="reset-sub"/>

                        <Label fx:id="lblNewLabel" text="New Password" styleClass="reset-label"/>
                        <StackPane alignment="CENTER_RIGHT">
                            <PasswordField fx:id="pfNew" prefHeight="54" styleClass="reset-field"/>
                            <TextField fx:id="tfNew" prefHeight="54" styleClass="reset-field" visible="false" managed="false"/>
                            <Button fx:id="btnEyeNew" text="👁" styleClass="reset-eye" onAction="#onEyeNew"/>
                        </StackPane>

                        <Label fx:id="lblConfirmLabel" text="Confirm Password" styleClass="reset-label"/>
                        <StackPane alignment="CENTER_RIGHT">
                            <PasswordField fx:id="pfConfirm" prefHeight="54" styleClass="reset-field"/>
                            <TextField fx:id="tfConfirm" prefHeight="54" styleClass="reset-field" visible="false" managed="false"/>
                            <Button fx:id="btnEyeConfirm" text="👁" styleClass="reset-eye" onAction="#onEyeConfirm"/>
                        </StackPane>

                        <HBox spacing="6">
                        <Region fx:id="str1" HBox.hgrow="ALWAYS" styleClass="seg,seg-off"/>
                        <Region fx:id="str2" HBox.hgrow="ALWAYS" styleClass="seg,seg-off"/>
                        <Region fx:id="str3" HBox.hgrow="ALWAYS" styleClass="seg,seg-off"/>
                        <Region fx:id="str4" HBox.hgrow="ALWAYS" styleClass="seg,seg-off"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblStrength" text="Password strength:" styleClass="reset-small"/>
                        </HBox>

                        <GridPane hgap="10" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <Label fx:id="chk1" text="○ 8+ characters" styleClass="chk" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="chk2" text="○ Upper &amp; lowercase" styleClass="chk" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label fx:id="chk3" text="○ At least one number" styleClass="chk" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="chk4" text="○ At least one symbol" styleClass="chk" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        </GridPane>

                        <Label fx:id="lblPwError" wrapText="true" styleClass="login-error"/>
                        <Button fx:id="btnResetPw" text="Reset Password  →" maxWidth="Infinity" prefHeight="56"
                                styleClass="login-btn" onAction="#onResetPassword"/>
                        <HBox alignment="CENTER">
                            <Button fx:id="btnBack3" text="←  Back to Login" styleClass="login-link" onAction="#onBack"/>
                        </HBox>
                    </VBox>

                    <!-- ================= STEP 4: done ================= -->
                    <VBox fx:id="stepDone" spacing="14" alignment="CENTER" visible="false" managed="false">
                        <Label text="✓" styleClass="done-circle"/>
                        <Label fx:id="lblDoneTitle" text="Password Reset" styleClass="reset-title-white"/>
                        <Label fx:id="lblDoneSub" text="Your password has been changed successfully. You can now sign in with your new password."
                               wrapText="true" textAlignment="CENTER" styleClass="reset-sub"/>
                        <Button fx:id="btnDone" text="Back to Login  →" maxWidth="Infinity" prefHeight="56"
                                styleClass="login-btn" onAction="#onBack"/>
                    </VBox>
                </VBox>
            </StackPane>
        </Pane>
    </Group>
</StackPane>
