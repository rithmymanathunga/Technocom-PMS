<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1180.0" prefHeight="780.0" styleClass="shell">
 <top><VBox spacing="6" styleClass="topbar"><Label text="PROCUREMENT MANAGEMENT" styleClass="h1"/><Label text="Purchase requests, supplier quotations, purchase orders and goods receiving." styleClass="sub"/></VBox></top>
 <center><VBox spacing="14"><padding><Insets top="22" right="24" bottom="24" left="24"/></padding>
  <HBox spacing="12"><VBox styleClass="card" HBox.hgrow="ALWAYS"><padding><Insets all="14"/></padding><Label text="Pending Requests" styleClass="stat-label"/><Label text="--" styleClass="stat-value"/></VBox><VBox styleClass="card" HBox.hgrow="ALWAYS"><padding><Insets all="14"/></padding><Label text="Awaiting Approval" styleClass="stat-label"/><Label text="--" styleClass="stat-value"/></VBox><VBox styleClass="card" HBox.hgrow="ALWAYS"><padding><Insets all="14"/></padding><Label text="Open Purchase Orders" styleClass="stat-label"/><Label text="--" styleClass="stat-value"/></VBox><VBox styleClass="card" HBox.hgrow="ALWAYS"><padding><Insets all="14"/></padding><Label text="Partially Received" styleClass="stat-label"/><Label text="--" styleClass="stat-value"/></VBox></HBox>
  <HBox spacing="10"><TextField promptText="Search request, supplier or item..." HBox.hgrow="ALWAYS"/><ComboBox promptText="Status"/><ComboBox promptText="Project"/><Button text="Search" styleClass="btn-outline"/><Button text="+ New Purchase Request" styleClass="btn-primary"/></HBox>
  <TabPane tabClosingPolicy="UNAVAILABLE"><tabs><Tab text="Purchase Requests"><TableView prefHeight="390"><columns><TableColumn text="Request No." prefWidth="110"/><TableColumn text="Project" prefWidth="180"/><TableColumn text="Requested By" prefWidth="150"/><TableColumn text="Request Date" prefWidth="120"/><TableColumn text="Required By" prefWidth="120"/><TableColumn text="Status" prefWidth="130"/></columns></TableView></Tab><Tab text="Purchase Orders"><TableView prefHeight="390"><columns><TableColumn text="PO No." prefWidth="110"/><TableColumn text="Supplier" prefWidth="180"/><TableColumn text="Project" prefWidth="180"/><TableColumn text="Order Date" prefWidth="120"/><TableColumn text="Total" prefWidth="120"/><TableColumn text="Status" prefWidth="130"/></columns></TableView></Tab><Tab text="Goods Received"><TableView prefHeight="390"><columns><TableColumn text="GRN No." prefWidth="110"/><TableColumn text="PO No." prefWidth="120"/><TableColumn text="Supplier" prefWidth="180"/><TableColumn text="Received Date" prefWidth="140"/><TableColumn text="Received By" prefWidth="140"/><TableColumn text="Status" prefWidth="120"/></columns></TableView></Tab></tabs></TabPane>
 </VBox></center>
</BorderPane>
